# Copy to .env and fill in real values. Never commit .env.
# All values here are placeholders only.

# ---------------------------------------------------------------------------
# Core infrastructure
# ---------------------------------------------------------------------------

# PostgreSQL connection string (database must have the pgvector extension available)
DATABASE_URL=

# Redis connection string (broker for background jobs + lightweight cache)
REDIS_URL=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Environment name: development | staging | production
APP_ENV=development

# Secret used to sign session cookies (generate a long random value)
SESSION_SECRET=

# Key (or key id) used for application-level encryption of stored OAuth tokens.
# In production this should come from a secrets manager / KMS, not a raw value here.
TOKEN_ENCRYPTION_KEY=

# Public base URL of the frontend (used to build OAuth redirect URIs, CORS, links)
APP_BASE_URL=http://localhost:3000

# Base URL of the backend API
API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# LLM / AI (provider and model chosen during Phase 10 / Phase 15)
# ---------------------------------------------------------------------------

LLM_API_KEY=
# Optional: override the default model / embedding model once decided
LLM_MODEL=
EMBEDDING_MODEL=

# ---------------------------------------------------------------------------
# Slack integration (verify scopes/URLs against current Slack API docs)
# ---------------------------------------------------------------------------

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=
# Used to verify inbound Slack event requests
SLACK_SIGNING_SECRET=

# ---------------------------------------------------------------------------
# Jira / Atlassian integration (Jira Cloud, OAuth 2.0 3LO)
# ---------------------------------------------------------------------------

JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=

# ---------------------------------------------------------------------------
# GitHub integration (OAuth App vs GitHub App decided in Phase 13)
# ---------------------------------------------------------------------------

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
# If using a GitHub App:
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
